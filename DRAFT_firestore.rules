rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Validar autenticidad
    function isSignedIn() { return request.auth != null; }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Colección Menu: Todos leen, solo Admin escribe
    match /menu/{platoId} {
      allow read: if true;
      allow write: if isSignedIn(); // Simplificado para pruebas; en prod requeriría isAdmin()
    }

    // Colección Pedidos: Clientes leen sus pedidos, Admin lee todos
    match /pedidos/{pedidoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }
  }
}
